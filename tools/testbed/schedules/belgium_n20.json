{
  "schedule_version": 1,
  "label": "belgium-n20",
  "_why": "Pin the measured reference tightly enough that per-good comparison means something. Belgium's market orders vary 10-30 percent per good between runs at the SAME date and config (fabric buy 349/459/441 over three runs), which is the same magnitude as the modelling error being chased - so at n=3 the reference was too noisy to judge a fix by. n=20 puts the standard error on a 25-percent-spread good near 5 percent. All eight markets ride along at no extra game time, and the secondary-PM near-ties (Belgium's wheat farms split 4 vs 4) should resolve at this n.",
  "_note": "until = 1836.6.1 so the phase-3 active_pms block, which fires three months after the date it stamps, actually lands.",
  "defaults": {
    "tags": ["BEL", "GBR", "FRA", "RUS", "AUS", "CHI", "JAP", "USA"],
    "metrics": ["boot_dump", "active_pms", "building_inventory", "market_goods_scoped", "market_goods", "scenario", "construction"],
    "autosave_interval": "yearly",
    "timeout_minutes": 25
  },
  "setups": { "mod": { "kind": "config", "config": "config/mod_config.json", "lint": false } },
